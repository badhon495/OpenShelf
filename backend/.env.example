# Production Environment Variables for Render Deployment

# REQUIRED - Generate a secure secret key for production
SECRET_KEY=your-secret-key-here

# REQUIRED - Set to False in production
DEBUG=False

# REQUIRED - PostgreSQL database connection string (provided by Render when you add a database)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=

# OPTIONAL - Your frontend domain for CORS configuration
FRONTEND_URL=https://your-frontend-domain.vercel.app

# OPTIONAL - Google OAuth credentials (only if using Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AUTOMATIC - Render provides this automatically, don't set manually
# RENDER_EXTERNAL_HOSTNAME=your-backend-domain.onrender.com

# CLOUDINARY CONFIGURATION - For image uploads
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
